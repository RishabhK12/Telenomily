# Telenomily environment
# Copy to .env.local at the repo root for the web app, and to apps/agent/.env.local for the agent.
# Do not commit filled secrets.

# live | rehearsal | leave empty to stay unconfigured
# Rehearsal is explicit. Missing keys never turn on a fake success path.
APP_MODE=

NEXT_PUBLIC_PRODUCT_NAME=Telenomily
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Grok. Confirm current model ids at https://docs.x.ai/
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.7
XAI_VISION_MODEL=grok-4.7
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE_NAME=ara

# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_AGENT_NAME=telenomily
LIVEKIT_SIP_TRUNK_ID=

# Shared by the web app and the agent. Long random string.
AGENT_SHARED_SECRET=
APP_URL=http://localhost:3000

# Only these numbers can be dialed. Comma separated E.164.
ALLOWED_CALL_NUMBERS=
DEMO_PATIENT_PHONE=
DEMO_PHARMACY_PHONE=

# Created by scripts/seed-demo.ts. Not committed.
DEMO_PATIENT_EMAIL=
DEMO_PATIENT_PASSWORD=
DEMO_FAMILY_EMAIL=
DEMO_FAMILY_PASSWORD=

PRESENTER_ACCESS_CODE=
REHEARSAL_COOKIE_SECRET=
